#!/bin/sh
# Git pre-commit hook for manotz

set -e

echo "🔍 Running pre-commit checks..."

# 1. Check code formatting
echo "  ↳ Checking code formatting (cargo fmt)..."
if ! cargo fmt --check; then
    echo "❌ Formatting check failed! Run 'cargo fmt' to format your code."
    exit 1
fi

# 2. Check clippy lints
echo "  ↳ Running clippy lints (cargo clippy)..."
if ! cargo clippy --all-targets --all-features -- -D warnings; then
    echo "❌ Clippy lints failed!"
    exit 1
fi

echo "✅ Pre-commit checks passed!"
